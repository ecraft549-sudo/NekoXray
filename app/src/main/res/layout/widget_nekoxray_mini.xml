<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg_idle"
    android:padding="6dp">

    <ImageView
        android:id="@+id/mini_status_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_dot_idle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/mini_power_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_power_btn_idle"
            android:contentDescription="@string/widget_toggle_vpn"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_power" />

        <TextView
            android:id="@+id/mini_status_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="Neko"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>
</RelativeLayout>
