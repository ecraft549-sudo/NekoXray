<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg_idle"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/compact_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_dot_idle" />

            <TextView
                android:id="@+id/compact_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="NekoXray"
                android:textColor="#F8FAFC"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/compact_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="VLESS · REALITY"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/compact_btn_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_power_btn_idle"
        android:contentDescription="@string/widget_toggle_vpn"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_power" />
</LinearLayout>
